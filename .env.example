# ---------------------------------------------------------------------------
# Ardmst portfolio — environment
#
# Copy to .env.local for local development. The values in this file are
# DEVELOPMENT values. A production build ignores every admin default below:
# see "Admin sign-in" for what must be set on the host (Vercel) instead.
# ---------------------------------------------------------------------------

# Public address of the site, used for canonical / Open Graph / sitemap URLs.
# Production: set it to https://portofolio.ardmst.my.id. If it is missing (or
# still points at localhost) a production build uses that address anyway.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (optional)
#
# While these stay on the placeholder values the app runs on the built-in
# local store (src/lib/data/local-store.ts): content comes from
# src/lib/data/seed.ts, and on a read-only host (Vercel) the CMS cannot save.
# Fill them in to store content, uploads and messages in a Supabase project.
# The image optimizer is only allowed to fetch from this Supabase host.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket used for thumbnails / gallery uploads.
NEXT_PUBLIC_SUPABASE_BUCKET=portfolio-media

# ---------------------------------------------------------------------------
# Admin sign-in (/admin) without Supabase
#
# Development (`next dev`): the three values below work as they are, and also
# apply when the variables are not set at all.
#
# Production (`next build` + `next start`, Vercel): there is NO default.
# /admin stays closed — sign-in answers 503 and no cookie is accepted — until
# all three are set to your own values:
#   LOCAL_ADMIN_EMAIL     your e-mail address (not admin@ardmst.local)
#   LOCAL_ADMIN_PASSWORD  at least 12 characters, not the value below
#   AUTH_SECRET           at least 32 random characters, not the value below
#                         node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
LOCAL_ADMIN_EMAIL=admin@ardmst.local
LOCAL_ADMIN_PASSWORD=ardmst

# HMAC key for the signed admin session cookie.
AUTH_SECRET=change-me-in-production-3f9a1c7b5e2d4a86

# With Supabase configured, the Supabase session is the only credential and the
# signed cookie above is ignored. Set this to "true" only if you really want the
# signed cookie accepted as a second proof of identity (it then also needs a
# real AUTH_SECRET). Leave it unset otherwise.
# AUTH_COOKIE_FALLBACK=false
