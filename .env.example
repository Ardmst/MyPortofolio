# ---------------------------------------------------------------------------
# Portototo — local development environment
# ---------------------------------------------------------------------------
# Supabase credentials. While these stay on the placeholder values the app
# automatically runs against the built-in local data store
# (see src/lib/data/repository.ts) so every feature can be exercised without a
# network connection. Fill them in to switch to the real Supabase project.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage bucket used for thumbnails / gallery uploads.
NEXT_PUBLIC_SUPABASE_BUCKET=portfolio-media

# ---------------------------------------------------------------------------
# Local fallback auth (only used while Supabase env values are placeholders).
# Lets you exercise /admin locally before a Supabase project exists.
# ---------------------------------------------------------------------------
LOCAL_ADMIN_EMAIL=admin@portototo.local
LOCAL_ADMIN_PASSWORD=portototo

# HMAC secret for the signed admin session cookie. Generate a long random
# value before deploying: `node -e "console.log(crypto.randomUUID())"`.
AUTH_SECRET=change-me-in-production-3f9a1c7b5e2d4a86
